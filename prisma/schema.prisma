generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Auth.js required tables ───────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  creditBalance Int       @default(0)

  accounts Account[]
  sessions Session[]
  ledger   CreditLedgerEntry[]
  jobs     Job[]
  assets   Asset[]
  projects Project[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── Domain tables ─────────────────────────────────────────────────────────────

// Append-only ledger; creditBalance on User is a denormalised cache kept in sync.
model CreditLedgerEntry {
  id        String   @id @default(cuid())
  userId    String
  delta     Int      // positive = credit, negative = debit
  reason    String   // "stripe_topup" | "image_gen" | "video_gen" | "admin" | "film_stage"
  jobId     String?
  projectId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job?     @relation(fields: [jobId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
}

model Job {
  id             String   @id @default(cuid())
  userId         String
  projectId      String?
  prompt         String
  modelId        String
  status         String   @default("pending") // pending | running | done | failed
  providerJobId  String?
  creditsCharged Int
  resultUrl      String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?            @relation(fields: [projectId], references: [id])
  asset   Asset?
  ledger  CreditLedgerEntry[]
}

// ── Film project tables ───────────────────────────────────────────────────────
// Script: one per project; scenes stored as JSON; chat history in ScriptMessage
model Script {
  id        String   @id @default(cuid())
  projectId String   @unique
  scenes    Json     @default("[]") // Scene[]
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages ScriptMessage[]
}

model ScriptMessage {
  id        String   @id @default(cuid())
  scriptId  String
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)
}



model Project {
  id           String   @id @default(cuid())
  userId       String
  title        String
  status       String   @default("draft") // draft | quoted | rendering | done
  targetLength Int      @default(180)     // seconds
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote       FilmQuote?
  script      Script?
  bible       StoryBible?
  storyboard  Storyboard?
  jobs        Job[]
  ledger      CreditLedgerEntry[]
}

model Storyboard {
  id        String   @id @default(cuid())
  projectId String   @unique
  shots     Json     @default("[]") // Shot[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model StoryBible {
  id         String   @id @default(cuid())
  projectId  String   @unique
  characters Json     @default("[]") // Character[]
  locations  Json     @default("[]") // Location[]
  props      Json     @default("[]") // Prop[]
  styleNotes String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Append-only once accepted — never edited after acceptedAt is set
model FilmQuote {
  id           String    @id @default(cuid())
  projectId    String    @unique
  totalCredits Int
  hardCap      Int       // spending ceiling; defaults to totalCredits at acceptance
  spentCredits Int       @default(0)
  lockedUntil  DateTime? // set when accepted, 24 h from that moment
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lineItems QuoteLineItem[]
}

model QuoteLineItem {
  id          String @id @default(cuid())
  quoteId     String
  stage       String // script | bible | storyboard | video | voice | music | export
  description String
  credits     Int

  quote FilmQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}


model Asset {
  id        String   @id @default(cuid())
  userId    String
  jobId     String   @unique
  url       String
  mimeType  String   @default("image/jpeg")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
}
